# URL del proyecto Supabase local o de staging para desarrollo.
# En Vercel Preview debe ser distinta a la URL de producción.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable de Supabase; se usa solo para Auth en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta para rutas Next.js. Nunca usar NEXT_PUBLIC_ ni subir a Git.
SUPABASE_SECRET_KEY=

# URL pública de la aplicación para construir los QR estáticos.
APP_BASE_URL=http://localhost:3000

# Mantener el despacho apagado hasta configurar el piloto.
PUSH_DISPATCH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NOTIFICATION_DISPATCH_SECRET=
